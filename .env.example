# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trust_marketplace?schema=public"

# Queue / Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Auth & Session (replace with strong 32+ char secret in production)
AUTH_SECRET="dev-only-replace-with-32-char-random-secret-key"
AUTH_PROVIDER="local-dev"

# Default currency (INR by default, configurable: INR | USD | EUR | GBP)
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
