# Supabase Database (PostgreSQL)
# DATABASE_URL: Transaction Pooler connection string (Port 6543) with pgbouncer=true for serverless functions
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Session connection string (Port 5432) for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Project Credentials (Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="deal-vault"

# Queue / Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Auth & Session (replace with strong 32+ char secret in production)
AUTH_SECRET="dev-only-replace-with-32-char-random-secret-key"
AUTH_PROVIDER="local-dev"

# Auth0 Managed Auth & SSO (optional; set AUTH_PROVIDER=auth0 to activate)
AUTH0_SECRET="dev-only-32-character-secret-key-here"
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"

# Default currency (INR by default, configurable: INR | USD | EUR | GBP)
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
