# Supabase Auth and per-user workflow storage (the anon/publishable key is intended for browsers).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side task proxy. Supabase values are also used to verify the signed-in
# user's token; do not use a service-role key here.
TASK_API_ORIGIN=https://mcp.dabcloud.in
TASK_API_TOKEN=

# Configure MCP_ACCESS_TOKEN and MCP_ALLOWED_ORIGINS as server-side Vercel
# environment variables. See the repository-root MCP_SETUP.md.
