{
  "buildCommand": "npm --prefix outputs/signal-shadow-waitlist install && npm --prefix outputs/signal-shadow-waitlist run build",
  "outputDirectory": "outputs/signal-shadow-waitlist/dist",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/tasks/:code/complete",
      "destination": "/api/task-complete?code=:code"
    },
    {
      "source": "/api/tasks/:code",
      "destination": "/api/task?code=:code"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
